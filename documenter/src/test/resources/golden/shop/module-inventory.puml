@startuml
title <size:24>Inventory</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("Shop_boundary", "Shop", $tags="") {
  Container_Boundary("Shop.Shop_boundary", "Shop", $tags="") {
    Component(Shop.Shop.Orders, "Orders", $techn="Module", $descr="", $tags="", $link="")
    Component(Shop.Shop.Inventory, "Inventory", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(Shop.Shop.Inventory, Shop.Shop.Orders, "listens to", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml