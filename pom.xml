<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse</groupId>
        <artifactId>quarkiverse-parent</artifactId>
        <version>26</version>
    </parent>
    <groupId>io.quarkiverse.modulith</groupId>
    <artifactId>quarkus-modulith-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Quarkus Modulith - Parent</name>
    <description>Build-time verified application modules, module events with a transactional outbox, and module documentation for Quarkus</description>

    <modules>
        <module>bom</module>
        <module>api</module>
        <module>core</module>
        <module>runtime</module>
        <module>runtime-dev</module>
        <module>deployment</module>
        <module>events/runtime</module>
        <module>events/deployment</module>
        <module>events-tck</module>
        <module>events-jpa/runtime</module>
        <module>events-jpa/deployment</module>
        <module>events-jdbc/runtime</module>
        <module>events-jdbc/deployment</module>
        <module>events-mongodb/runtime</module>
        <module>events-mongodb/deployment</module>
        <module>events-neo4j/runtime</module>
        <module>events-neo4j/deployment</module>
        <module>events-messaging/runtime</module>
        <module>events-messaging/deployment</module>
        <module>events-jms/runtime</module>
        <module>events-jms/deployment</module>
        <module>events-jobrunr/runtime</module>
        <module>events-jobrunr/deployment</module>
        <module>moments/runtime</module>
        <module>moments/deployment</module>
        <module>observability/runtime</module>
        <module>observability/deployment</module>
        <module>flyway/runtime</module>
        <module>flyway/deployment</module>
        <module>documenter</module>
        <module>apt</module>
        <module>junit</module>
        <module>junit-changes</module>
    </modules>

    <scm>
        <connection>scm:git:git@github.com:quarkiverse/quarkus-modulith.git</connection>
        <developerConnection>scm:git:git@github.com:quarkiverse/quarkus-modulith.git</developerConnection>
        <url>https://github.com/quarkiverse/quarkus-modulith</url>
        <tag>1.0.0</tag>
    </scm>

    <properties>
        <compiler-plugin.version>3.14.1</compiler-plugin.version>
        <quarkus.version>3.40.1.2</quarkus.version>
        <build-helper-plugin.version>3.6.2</build-helper-plugin.version>
        <jacoco.version>0.8.16</jacoco.version>
        <dependency-plugin.version>3.11.0</dependency-plugin.version>
        <!-- Set by jacoco:prepare-agent, empty when JaCoCo is skipped -->
        <jacoco.argLine />
        <!--
            The JVM options of the test JVMs: Mockito attaches its agent at run time, and Quarkus adjusts the Java module
            configuration on JDK 25. The Quarkus Maven extension adds its own options in the modules that build an
            application.
        -->
        <argLine>-XX:+EnableDynamicAgentLoading --add-opens=java.base/java.lang.invoke=ALL-UNNAMED</argLine>
        <assertj.version>3.27.6</assertj.version>
        <archunit.version>1.4.2</archunit.version>
        <!-- JobRunr's Quarkus extension. The same release serves both Quarkus lines. -->
        <jobrunr.version>9.0.4</jobrunr.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jobrunr</groupId>
                <artifactId>quarkus-jobrunr</artifactId>
                <version>${jobrunr.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jobrunr</groupId>
                <artifactId>quarkus-jobrunr-deployment</artifactId>
                <version>${jobrunr.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-extension-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-config-doc-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>@{argLine} @{jacoco.argLine}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <argLine>@{argLine} @{jacoco.argLine}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
                Every test JVM runs with the JaCoCo agent. Unit tests, QuarkusExtensionTest and QuarkusTest write
                target/jacoco.exec, the packaged application started by QuarkusIntegrationTest writes
                target/jacoco-it.exec. The coverage module merges them and enforces 100% line and branch coverage.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacoco.argLine</propertyName>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                            <includes>
                                <include>io.quarkiverse.modulith.*</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <propertyName>jacoco.it.argLine</propertyName>
                            <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                            <includes>
                                <include>io.quarkiverse.modulith.*</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>docs</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>!true</value>
                </property>
            </activation>
            <modules>
                <module>docs</module>
            </modules>
        </profile>
        <profile>
            <id>it</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>!true</value>
                </property>
            </activation>
            <modules>
                <module>integration-tests</module>
                <module>coverage</module>
            </modules>
        </profile>
    </profiles>
</project>
