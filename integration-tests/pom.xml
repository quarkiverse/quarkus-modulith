<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.modulith</groupId>
        <artifactId>quarkus-modulith-parent</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>
    <artifactId>quarkus-modulith-integration-tests-parent</artifactId>
    <packaging>pom</packaging>
    <name>Quarkus Modulith - Integration Tests - Parent</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>shop</module>
        <module>violations</module>
        <module>module-tests</module>
        <module>spring-compat</module>
        <module>events-jdbc</module>
        <module>events-mongodb</module>
        <module>events-neo4j</module>
        <module>externalization-kafka</module>
        <module>externalization-kafka-outbox</module>
        <module>externalization-rabbitmq</module>
        <module>externalization-jms</module>
        <module>moments</module>
        <module>observability</module>
        <module>flyway</module>
        <module>externalization-amqp</module>
        <module>externalization-jobrunr</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <systemPropertyVariables>
                            <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <!-- The native run only tests the executable. The JVM tests already run in the regular build. -->
            <id>native-skips-jvm-tests</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <native.surefire.skip>true</native.surefire.skip>
            </properties>
        </profile>
        <profile>
            <!-- Runs the application packaged as a jar with the JaCoCo agent. Native executables cannot take it. -->
            <id>jacoco-integration-tests</id>
            <activation>
                <property>
                    <name>!native</name>
                </property>
            </activation>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <artifactId>maven-failsafe-plugin</artifactId>
                            <configuration>
                                <systemPropertyVariables>
                                    <quarkus.test.arg-line>${jacoco.it.argLine}</quarkus.test.arg-line>
                                </systemPropertyVariables>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
