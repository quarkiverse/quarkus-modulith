<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.quarkiverse.modulith</groupId>
        <artifactId>quarkus-modulith-integration-tests-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>quarkus-modulith-integration-tests-spring-compat</artifactId>
    <name>Quarkus Modulith - Integration Tests - Spring compatibility</name>
    <description>The package structure of a Spring Modulith 2.1 application, with nine modules, that keeps Spring Modulith's annotations. Its ModularityTests compiles against quarkus-modulith-core and quarkus-modulith-documenter after an import change.</description>

    <dependencies>
        <dependency>
            <groupId>io.quarkiverse.modulith</groupId>
            <artifactId>quarkus-modulith</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Only the annotations, read from the class files by the Quarkus build -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
            <version>2.1.2</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.modulith</groupId>
            <artifactId>quarkus-modulith-documenter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Builds the deployment module first, also with -pl and -am -->
        <dependency>
            <groupId>io.quarkiverse.modulith</groupId>
            <artifactId>quarkus-modulith-deployment</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
